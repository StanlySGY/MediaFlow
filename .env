# ===========================================
# MediaFlow 环境配置文件
# 复制此文件为 .env 并修改下方配置项
# ===========================================

# --- ASR 语音识别后端（OpenAI 兼容格式） ---
# 接口类型，二选一：
#   openai_compat      → Whisper 风格接口 /v1/audio/transcriptions（multipart 上传）
#                        适用于：Whisper API、faster-whisper-server、DashScope 兼容接口、
#                        Paraformer/SenseVoice OpenAI 适配器
#   openai_chat_audio  → 多模态对话接口 /v1/chat/completions（JSON + base64）
#                        适用于：vLLM Qwen3-ASR-Flash、DashScope 对话端点、
#                        任何作为 ASR 使用的多模态大模型。不支持逐字时间戳。
ASR_PROVIDER=openai_compat
# ASR 服务地址，替换为你的实际地址
# 示例：http://172.16.100.26:8022/v1（本地部署）
# 示例：https://dashscope.aliyuncs.com/compatible-mode/v1（阿里云 DashScope）
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# API 密钥，内网无鉴权可留空
ASR_API_KEY=
# 模型名称
ASR_MODEL=qwen3-asr-flash
# 识别语言：zh 中文 / en 英文 / 留空自动判断
ASR_LANGUAGE=zh
# 单次 ASR 请求超时时间（秒）
ASR_TIMEOUT=120
# 是否请求逐字时间戳（开启后字幕更精准，上游不支持时请关闭）
ASR_TIMESTAMPS=true

# --- 可选：热词和上下文提示 ---
# 热词：逗号分隔的专有名词，提高识别准确率（如 "千问,ASR,声学模型"）
ASR_HOTWORDS=
# 上下文提示：自由文本，告诉模型这段音频的背景
ASR_PROMPT_HINTS=

# --- 音频切片配置 ---
# 切片策略：silence（按静音切片）| fixed（固定时长）| overlap（重叠切片）
SPLIT_STRATEGY=silence
# 每片时长（秒），长音频会自动切片
SPLIT_CHUNK_SECONDS=30
# 重叠时长（秒），overlap 策略时使用
SPLIT_OVERLAP_SECONDS=2
# 静音检测阈值（dB），低于此值视为静音
SILENCE_NOISE_DB=-30
# 最小静音时长（秒），短于此值的静音不会触发切片
SILENCE_MIN_DURATION=0.4

# --- 并发和重试 ---
# 最大并发 ASR 调用数（同时识别的分片数量，越大越快但更耗资源）
ASR_CONCURRENCY=4
# 失败重试次数
ASR_MAX_RETRIES=3
# 重试退避系数（每次重试等待时间 = 上次等待 × 此系数）
ASR_RETRY_BACKOFF=1.5

# --- FFmpeg 执行 ---
# 单个 FFmpeg 进程超时时间（秒），防止卡死
FFMPEG_TIMEOUT=1800
# 最大并发 FFmpeg 切片进程数
FFMPEG_CONCURRENCY=4

# --- 资源限制 ---
# 最大上传文件大小（字节），默认 2 GiB
MAX_UPLOAD_BYTES=2147483648
# 内存中最大任务数
MAX_TASKS_IN_MEMORY=100
# 任务结果保留时间（秒）
TASK_TTL_SECONDS=3600

# --- 访问令牌（可选） ---
# 逗号分隔的访问令牌，留空表示不启用鉴权
# 客户端通过 Authorization: Bearer <token> 或 ?token=<token> 传递
ACCESS_TOKENS=

# --- 实时识别 ---
# 实时接口类型，三选一：
#   realtime_mock      → 模拟数据，用于测试流水线（无真实 ASR）
#   realtime_http      → 对接标准实时服务（需自建 shim 转换 FunASR WebSocket 等非标后端）
#   realtime_offline   → 缓存音频块，录音结束后调用 ASR_PROVIDER 转写（模拟流式）
REALTIME_ASR_PROVIDER=realtime_mock
# 实时接口地址（realtime_http 模式时填写）
REALTIME_ASR_BASE_URL=
# 实时接口密钥（realtime_http 模式时填写）
REALTIME_ASR_API_KEY=
# 实时模型名称（realtime_http 模式时填写）
REALTIME_ASR_MODEL=
# 最大并发实时会话数
REALTIME_MAX_SESSIONS=100
# 实时会话超时时间（秒），录音时长上限
REALTIME_SESSION_TTL_SECONDS=300
# 单个音频块最大大小（字节），默认 1 MiB
REALTIME_MAX_CHUNK_BYTES=1048576

# --- 存储目录 ---
# 临时文件目录
TEMP_DIR=./temp
# 输出文件目录
OUTPUT_DIR=./outputs

# --- 服务配置 ---
# 监听地址
HOST=0.0.0.0
# 监听端口
PORT=8999
# 日志级别：debug / info / warning / error
LOG_LEVEL=info
