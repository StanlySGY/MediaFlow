# Optional Docker Compose bind-mount identity. Set these to your host user's
# numeric UID/GID when temp/, outputs/, or config/ are owned by that user.
# MEDIAFLOW_UID=1000
# MEDIAFLOW_GID=1000

# --- ASR backend (OpenAI-compatible) ---
# Provider selects the upstream API style:
#   openai_compat      → POST /v1/audio/transcriptions  (Whisper-style, multipart)
#                        Use for Whisper API, faster-whisper-server, DashScope compat
#                        transcriptions endpoint, Paraformer/SenseVoice OpenAI shims
#   openai_chat_audio  → POST /v1/chat/completions      (multimodal chat, JSON)
#                        Use for vLLM Qwen3-ASR-Flash, DashScope compat chat endpoint,
#                        any multimodal LLM serving as ASR. No word timestamps.
ASR_PROVIDER=openai_compat
ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash
ASR_LANGUAGE=zh
ASR_TIMEOUT=120
ASR_TIMESTAMPS=true               # request verbose_json + word/segment timestamps
                                  # if your upstream (some vLLM builds) rejects this, set to false

# Optional biasing — leave empty to disable.
# ASR_HOTWORDS: comma-separated jargon/names to bias toward (e.g. "千问,ASR,声学模型")
# ASR_PROMPT_HINTS: free-form context sent verbatim as the OpenAI `prompt` field
ASR_HOTWORDS=
ASR_PROMPT_HINTS=

# --- Audio splitting ---
SPLIT_STRATEGY=silence            # fixed | silence | overlap
SPLIT_CHUNK_SECONDS=30
SPLIT_OVERLAP_SECONDS=2
SILENCE_NOISE_DB=-30
SILENCE_MIN_DURATION=0.4

# --- Concurrency & retry ---
ASR_CONCURRENCY=4
ASR_MAX_RETRIES=3
ASR_RETRY_BACKOFF=1.5

# --- FFmpeg execution ---
FFMPEG_TIMEOUT=1800               # per-process wall-clock cap (s); guards a hung/corrupt input
FFMPEG_CONCURRENCY=4              # max concurrent ffmpeg slice processes (caps fork fan-out)

# --- Limits ---
MAX_UPLOAD_BYTES=2147483648       # 2 GiB per file
# How many uploads may be in flight at once. ASR_CONCURRENCY caps upstream
# calls, not disk writes; without this, several clients can each push a 2 GiB
# file to the same volume at the same time.
MAX_CONCURRENT_UPLOADS=2
# Uploads are refused (507) while the temp/output volume has less free space
# than this plus the declared upload size. 0 disables the check.
MIN_FREE_DISK_BYTES=536870912     # 512 MiB
MAX_TASKS_IN_MEMORY=100
TASK_TTL_SECONDS=3600
OUTPUT_TTL_SECONDS=604800       # retain finished task outputs for 7 days
# History listing is served from a cached index. Every refresh stats one file
# per archived task, so this bounds how often that scan may run; a task that
# just finished forces its own refresh immediately.
HISTORY_REFRESH_SECONDS=1.0

# --- Auth ---
# Comma-separated tokens. Leave empty only for loopback-only deployments.
# Set a strong token before exposing the service to any other machine.
# Clients pass `Authorization: Bearer <token>` for HTTP. The server then issues
# a short-lived HttpOnly cookie for browser EventSource connections. CLI clients
# may use `?token=<token>` for SSE compatibility, but query tokens can enter logs.
ACCESS_TOKENS=

# --- Realtime ---
# realtime_mock      → synthetic provider for pipeline testing (no real ASR)
# realtime_http      → standard downstream service speaking POST /session,
#                      POST /session/{id}/audio (JSON base64), GET /events (SSE),
#                      POST /session/{id}/end.
# realtime_ws        → native Qwen3-ASR WebSocket /v1/asr/stream. Browser WebM
#                      is converted to 16k mono PCM by a per-session FFmpeg process;
#                      partial/final events are forwarded immediately.
# realtime_offline   → accepts realtime base64 chunks, buffers them, then calls
#                      ASR_PROVIDER at end and emits simulated SSE text events.
REALTIME_ASR_PROVIDER=realtime_mock
# realtime_ws example: ws://10.0.0.20:8022/v1/asr/stream
REALTIME_ASR_BASE_URL=
REALTIME_ASR_API_KEY=
REALTIME_ASR_MODEL=
# 最大并发实时会话数。上游连接层允许 8 路，但实测（4 档节流 × 1/3/6/8 路）表明
# 上游推理是全局锁串行的：6 路尾延迟 >4s，8 路只有 1/8 能在 20s 内拿到终稿。
# 4 路以内尾延迟 <2s，是"实时可用"的边界，所以默认收紧到 4。
REALTIME_MAX_SESSIONS=4
REALTIME_SESSION_TTL_SECONDS=300
REALTIME_MAX_CHUNK_BYTES=1048576    # 1 MiB per chunk
REALTIME_MAX_SESSION_BYTES=104857600 # 100 MiB per recording
REALTIME_MAX_SESSION_SECONDS=3600    # 1 hour per recording

# --- Storage ---
TEMP_DIR=./temp
OUTPUT_DIR=./outputs

# --- Server ---
HOST=127.0.0.1
PORT=8999
LOG_LEVEL=info
